# Copy this file to ".env" and fill in your own values.
PORT=3000

# Local MongoDB:      mongodb://127.0.0.1:27017/votingapp
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/votingapp
MONGODB_URL=mongodb://127.0.0.1:27017/votingapp

# Use a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Used only by:  npm run create-admin
ADMIN_NAME=Election Admin
ADMIN_AGE=40
ADMIN_ADDRESS=Election Commission Office
ADMIN_AADHAR=999999999999
ADMIN_PASSWORD=ChangeMe@123
